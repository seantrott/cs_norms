y = "Dominance") +
theme_minimal() +
theme(text = element_text(size=16))
df_lancaster <- read_csv("../../data/lexical/lancaster_norms.csv") %>%
mutate(word = tolower(Word)) %>%
rename(
Foot_leg.SD.LS = Foot_leg.SD,
Hand_arm.SD.LS = Hand_arm.SD,
Head.SD.LS = Head.SD,
Torso.SD.LS = Torso.SD
)
df_dom_plus_sm <- df_dom_plus_sm %>%
inner_join(df_lancaster)
nrow(df_dom_plus_sm)
df_dom_gpt <- df_dom_gpt %>%
inner_join(df_lancaster)
nrow(df_dom_gpt)
model_full = lmer(data = df_dom_plus_sm,
dominance ~
max_strength +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
model_full = lmer(data = df_dom_plus_sm,
dominance ~
max_strength_gpt +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
model_full = lmer(data = df_dom_gpt,
dominance ~
max_strength_gpt +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
model_reduced = lmer(data = df_dom_gpt,
dominance ~
# max_strength_gpt +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
summary(model_full)
model_full = lmer(data = df_dom_gpt,
dominance ~
minkowski3_strength_gpt +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
model_reduced = lmer(data = df_dom_gpt,
dominance ~
# minkowski3_strength_gpt +
Max_strength.sensorimotor + Minkowski3.sensorimotor +
(1 | word),
REML = FALSE)
summary(model_full)
anova(model_full, model_reduced)
library(vegan)
# Get upper triangle (off-diagonal) entries
upper_human <- cors_human[upper.tri(cors_human)]
upper_gpt   <- cors_gpt[upper.tri(cors_gpt)]
# Correlation between the two
cor(upper_human, upper_gpt, method = "pearson")
cor(upper_human, upper_gpt, method = "spearman")
install.packages("vegan")
library(vegan)
library(vegan)
# Mantel test on the correlation matrices
mantel_result <- mantel(cors_human, cors_gpt,
method = "pearson",   # or "spearman"
permutations = 9999)
mantel_result
upper_human <- cors_human[upper.tri(cors_human)]
upper_gpt   <- cors_gpt[upper.tri(cors_gpt)]
# Correlation between the two
cor(upper_human, upper_gpt, method = "pearson")
cor(upper_human, upper_gpt, method = "spearman")
mantel_result <- mantel(cors_human, cors_gpt,
method = "spearman",   # or "spearman"
permutations = 9999)
mantel_result
