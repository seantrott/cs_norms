df_dom_gpt %>%
ggplot(aes(x = minkowski3_strength_gpt,
y = minkowski3_strength)) +
geom_point(alpha = .5) +
geom_smooth(method = "lm") +
labs(y = "Minkowski-3 Strength (GPT-4)",
x = "Minkowski-3 Strength (Human)") +
theme_minimal() +
