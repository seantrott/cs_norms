anova(model_full, model_reduced)
df_dom_plus_sm %>%
mutate(resid = residuals(model_reduced)) %>%
ggplot(aes(x = max_strength,
y = resid)) +
geom_point(alpha = .4) +
geom_smooth(method = "lm") +
labs(x = "Maximum Contextualized Strength",
y = "Residuals (Reduced model)") +
theme_bw()
