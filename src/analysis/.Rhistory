anova(model_full_at, model_reduced_at)
df_rawc_with_sm %>%
group_by(same, ambiguity_type) %>%
summarise(mean_gpt = mean(sm_gpt),
sd_gpt = sd(sm_gpt),
mean_human = mean(sm_human),
sd_human = sd(sm_human))
summary(model_full)
anova(model_full, model_reduced)
summary(model_full)
