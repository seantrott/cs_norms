df_residuals <- df_residuals %>%
mutate(JudgmentType = case_when(
Dimension %in% c("Vision", "Hearing", "Olfaction", "Taste",
"Interoception", "Touch") ~ "Perception",
Dimension %in% c("Mouth_throat", "Head", "Torso",
"Hand_arm", "Foot_leg") ~ "Action"
))
df_residuals %>%
group_by(JudgmentType) %>%
summarise(MAE = mean(abs(Residual), na.rm = TRUE),
sd_abs = sd(abs(Residual), na.rm = TRUE),
n = n(),
se = sd_abs / sqrt(n))
m_judgment <- lmer(abs(Residual) ~ JudgmentType + (1|word),
data = df_residuals)
summary(m_judgment)
This tests whether GPT systematically does better on one type than the other, collapsing across specific dimensions.
df_dom_gpt %>%
ggplot(aes(x = max_strength_gpt,
y = dominance)) +
geom_point(alpha = .4) +
geom_smooth(method = "lm") +
labs(x = "Maximum Contextualized Strength (GPT-4)",
y = "Dominance") +
theme_minimal() +
theme(text = element_text(size=16))
