df_dom_gpt = df_dom_gpt %>%
rowwise() %>%
mutate(max_strength_gpt = max(
c(
## Modalities
Vision,
Hearing,
Olfaction,
Touch,
Taste,
Interoception,
## Effectors
Head,
Mouth_throat,
Torso,
Hand_arm,
Foot_leg
)
),
minkowski3_strength_gpt = sum(c(Vision,
Hearing,
Olfaction,
Touch,
Taste,
Interoception,
## Effectors
Head,
Mouth_throat,
Torso,
Hand_arm,
Foot_leg)^3)^(1/3),
max_strength = max(
c(
## Modalities
Vision.M,
Hearing.M,
Olfaction.M,
Touch.M,
Taste.M,
Interoception.M,
## Effectors
Head.M,
Mouth_throat.M,
Torso.M,
Hand_arm.M,
Foot_leg.M
)
),
minkowski3_strength = sum(c(Vision.M, Hearing.M, Olfaction.M, Touch.M, Taste.M,
Interoception.M, Head.M, Mouth_throat.M, Torso.M,
Hand_arm.M, Foot_leg.M)^3)^(1/3)
) %>%
ungroup()
cor.test(df_dom_gpt$max_strength)
cor.test(df_dom_gpt$max_strength_gpt, df_dom_gpt$max_strength)
cor.test(df_dom_gpt$minkowski3_strength_gpt, df_dom_gpt$minkowski3_strength)
